# AI Business Copilot Environment Configuration

# Project Info
PROJECT_NAME="AI Business Copilot"
ENVIRONMENT="development"

# Database (Default: local SQLite database file)
DATABASE_URL="sqlite:///./copilot_erp.db"

# Inference Provider Options:
# 1. "local" (Default: High-accuracy deterministic analytics engine. ZERO API keys required!)
# 2. "cloud" (Optional: Connects to OpenAI/compatible LLM provider if API key provided)
# 3. "qualcomm" (Phase 2 Snapdragon NPU integration adapter)
INFERENCE_PROVIDER="local"

# Optional Cloud LLM credentials (only needed if INFERENCE_PROVIDER="cloud")
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Only needed if INFERENCE_PROVIDER="qualcomm" — path to the genie_bundle/
# directory produced by `qai_hub_models` export on the Snapdragon X Elite
# device. See README's Phase 2 section for the full pipeline.
QUALCOMM_MODEL_DIR=""

